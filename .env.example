COMPOSE_PROJECT_NAME=docker-platform

# Core app configuration
APP_ENV=dev
POSTGRES_USER=postgres
POSTGRES_DB=docker_platform
API_PORT=8000
FRONTEND_PORT=3000
ADMINER_PORT=8080
VITE_API_BASE_URL=

# Optional prod-like local resource tuning
API_MEM_LIMIT=1g
API_CPU_LIMIT=1.00
WORKER_MEM_LIMIT=1g
WORKER_CPU_LIMIT=1.00
FRONTEND_MEM_LIMIT=512m
FRONTEND_CPU_LIMIT=0.50
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=1.00
REDIS_MEM_LIMIT=512m
REDIS_CPU_LIMIT=0.50

# Secrets are loaded from files (do not put real values here):
# - secrets/postgres_password.txt
# - secrets/jwt_secret.txt
